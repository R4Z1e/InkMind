rules_version = '2';
// Regras do Inkmind — cole em Firestore Database → Regras → Publicar
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // visitante = login anônimo: só joga em mesas públicas
    function isAnon() { return request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function fullUser() { return signedIn() && !isAnon(); }
    function me() { return request.auth.uid; }
    // Administradores (moderação): coloque aqui o e-mail verificado da conta de quem modera
    function admins() { return []; }
    function isAdmin() { return fullUser() && request.auth.token.email_verified == true && request.auth.token.email.lower() in admins(); }
    function masterOf(gid) { return exists(/databases/$(database)/documents/games/$(gid)) && get(/databases/$(database)/documents/games/$(gid)).data.masterId == me(); }

    // Projetos, capítulos, comentários, versões e preferências: só o dono
    match /data/users/{uid}/{key} {
      allow read, write: if fullUser() && me() == uid;
    }

    // Perfil público (nome que aparece na mesa)
    match /profiles/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && me() == uid;
    }

    // Mesas de jogo
    //  - pública: qualquer pessoa com conta lê e entra sozinha até o limite de jogadores
    //  - particular: só o mestre e os jogadores aprovados leem; entrada só com aprovação do mestre
    //  - mesas antigas (sem o campo access) continuam abertas como antes
    function gameOf(gid) { return get(/databases/$(database)/documents/games/$(gid)).data; }
    function canReadGame(g) {
      return g.masterId == me() || g.get('access', 'legacy') != 'private' || g.get('players', {}).get(me(), false) == true;
    }
    function playersAfter() { return request.resource.data.get('players', {}); }
    function playersBefore() { return resource.data.get('players', {}); }
    function joinOrLeave() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players']) &&
        playersAfter().diff(playersBefore()).affectedKeys().hasOnly([me()]) &&
        (!(me() in playersAfter()) ||
          (playersAfter()[me()] == true &&
           playersAfter().size() <= resource.data.get('maxPlayers', 99) &&
           resource.data.get('access', 'legacy') != 'private' &&
           (!isAnon() || resource.data.get('access', 'legacy') == 'public') &&
           !(me() in resource.data.get('banned', {}))));
    }
    match /games/{gid} {
      allow read: if signedIn() && (resource == null || canReadGame(resource.data));
      allow create: if fullUser() && request.resource.data.masterId == me();
      allow update: if signedIn() && (
        (resource.data.masterId == me() && request.resource.data.masterId == me()) || joinOrLeave() ||
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['access']) && request.resource.data.access == 'private'));
      allow delete: if signedIn() && resource.data.masterId == me();
      match /maps/{mid} {
        allow read: if signedIn() && canReadGame(gameOf(gid));
        allow write: if signedIn() && masterOf(gid);
      }
      // Notas do mestre e revelações preparadas: só o mestre
      match /secret/{doc} {
        allow read, write: if signedIn() && masterOf(gid);
      }
      // Pedidos de entrada (mesa particular)
      match /requests/{uid} {
        allow read: if signedIn() && (me() == uid || masterOf(gid));
        allow create: if fullUser() && me() == uid && request.resource.data.get('status', 'pending') == 'pending' &&
          request.resource.data.keys().hasOnly(['name', 't', 'status']);
        allow update: if signedIn() && masterOf(gid);
        allow delete: if signedIn() && (me() == uid || masterOf(gid));
      }
    }

    // Convites: o código leva até a mesa; só o mestre cria ou apaga
    match /invites/{code} {
      allow read: if signedIn();
      allow create, update: if fullUser() && masterOf(request.resource.data.gid);
      allow delete: if signedIn() && masterOf(resource.data.gid);
    }

    // Fichas dos jogadores: cada um mexe na sua; o mestre mexe só na parte da mesa dele (campo g.<mesa>)
    match /seats/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && (
        me() == uid ||
        (request.resource.data._gm is string && masterOf(request.resource.data._gm) &&
         request.resource.data.keys().hasOnly(['uid', 'gids', 'g', '_gm']) &&
         request.resource.data.gids == [request.resource.data._gm] &&
         request.resource.data.g.keys().hasOnly([request.resource.data._gm])));
      allow update: if signedIn() && (
        me() == uid ||
        (request.resource.data._gm is string && masterOf(request.resource.data._gm) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['g', 'gids', '_gm']) &&
         request.resource.data.g.diff(resource.data.get('g', {})).affectedKeys().hasOnly([request.resource.data._gm]) &&
         request.resource.data.get('gids', []).toSet().difference(resource.data.get('gids', []).toSet()).hasOnly([request.resource.data._gm]) &&
         resource.data.get('gids', []).toSet().difference(request.resource.data.get('gids', []).toSet()).size() == 0));
      allow delete: if signedIn() && me() == uid;
    }

    // Presença (quem está online na mesa)
    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && me() == uid;
    }

    // Biblioteca pública: qualquer pessoa lê; cada autor publica só o que é seu
    match /pubs/{owner} {
      allow read: if true;
      allow write: if fullUser() && me() == owner;
      match /{rest=**} {
        allow read: if true;
        allow write: if fullUser() && me() == owner;
      }
    }

    // Denúncias: qualquer pessoa conectada envia; só a moderação lê e resolve
    match /reports/{rid} {
      allow create: if signedIn() && request.resource.data.by == me() && request.resource.data.status == 'open' &&
        request.resource.data.keys().hasOnly(['by', 'byName', 'target', 'reason', 'text', 't', 'status']) &&
        request.resource.data.reason is string && request.resource.data.reason.size() < 20 &&
        request.resource.data.get('text', '').size() <= 1500 && request.resource.data.target is map;
      allow read, update, delete: if isAdmin();
    }

    // Conteúdo ocultado pela moderação: todos leem (para filtrar Explorar); só a moderação mexe
    match /hidden/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Imagens enviadas: leitura pública (endereços impossíveis de adivinhar); só o dono cria/apaga
    match /blobs/{id} {
      allow read: if true;
      allow create: if fullUser() && request.resource.data.owner == me() && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow update, delete: if signedIn() && resource.data.owner == me();
    }
  }
}
